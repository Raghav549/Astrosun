import React,{useEffect,useState} from 'react';
import {createRoot} from 'react-dom/client';
import {Orbit, BookOpen, Sparkles, Telescope, Calculator, CalendarDays, ChevronRight, Atom, Globe2, ShieldCheck, Activity, Eclipse, MapPin, ArrowLeft, Search, Settings2, Star, Moon, Sun, FlaskConical, Clock3, Database, Layers3, Play, RotateCcw} from 'lucide-react';
import {buildRuntimeSnapshot} from './core';
import {computePanchanga} from './core/panchanga/engine';
import './styles.css';

const navItems=[['Home',Sparkles],['Explore',Telescope],['Panchanga',CalendarDays],['Kundali',Orbit],['Research',BookOpen]];
const exploreItems=[
 ['Sky Lab','Live solar-system geometry, angular positions and observer tools',Telescope,'sky'],
 ['Astrophysics','Relativity, cosmology, stellar and planetary physics tools',Atom,'physics'],
 ['Eclipse Lab','Solar/lunar eclipse geometry and contact analysis',Eclipse,'eclipse'],
 ['Observer Lab','Rise/set, refraction, local sky and observer geometry',MapPin,'observer'],
 ['Dynamics','Kepler, N-body propagation and invariant checks',Activity,'dynamics'],
 ['Evidence Graph','Research claims, provenance, uncertainty and citations',Database,'evidence'],
];

function GlassButton({children,onClick,accent=false}){return <button className={accent?'btn btnAccent':'btn'} onClick={onClick}>{children}</button>}
function TiltCard({children,className='',onClick}){return <button onClick={onClick} className={`tiltCard ${className}`}>{children}</button>}
function Header({onHome}){return <header className="topbar"><button className="brand" onClick={onHome}><span className="brandMark"><Orbit/></span><span><b>ASTROSUN</b><small>COSMIC INTELLIGENCE</small></span></button><div className="topActions"><button className="iconButton"><Search size={19}/></button><button className="iconButton"><Settings2 size={19}/></button></div></header>}
function PageTitle({eyebrow,title,text,onBack}){return <section className="pageTitle">{onBack&&<button className="backButton" onClick={onBack}><ArrowLeft size={18}/></button>}<div><span className="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{text}</p></div></section>}
function StatCard({icon:Icon,label,value,sub,tint=''}){return <div className={`statCard ${tint}`}><div className="statIcon"><Icon size={19}/></div><span>{label}</span><strong>{value}</strong><small>{sub}</small></div>}

function HomePage({runtime,open}){
 const passed=runtime.invariants.filter(x=>x.passed).length;
 const moon=runtime.positions.find(x=>x.body==='Moon'); const sun=runtime.positions.find(x=>x.body==='Sun');
 return <main className="page homePage">
  <section className="hero3d">
   <div className="orbitalRing ring1"/><div className="orbitalRing ring2"/><div className="heroSun"><Sun size={54}/></div><div className="heroMoon"><Moon size={28}/></div>
   <div className="heroCopy"><span className="eyebrow">ASTRONOMY × ASTROPHYSICS × JYOTISHA</span><h1>Explore the universe<br/><em>as a living system.</em></h1><p>One scientific workspace for celestial geometry, Panchanga, dynamics, research evidence and computational experiments.</p><div className="heroButtons"><GlassButton accent onClick={()=>open('Explore')}>Enter Sky Lab <ChevronRight size={17}/></GlassButton><GlassButton onClick={()=>open('Research')}>Research vault <BookOpen size={17}/></GlassButton></div></div>
   <div className="heroFloat"><span>LIVE COMPUTE</span><b>{runtime.panchanga.tithi.paksha} {runtime.panchanga.tithi.number}</b><small>{runtime.panchanga.nakshatra.name} • {runtime.panchanga.yogaName}</small></div>
  </section>
  <section className="statsGrid">
   <StatCard icon={Sun} label="Sun longitude" value={`${sun?.longitudeDeg.toFixed(2)}°`} sub="analytical baseline" tint="yellow"/>
   <StatCard icon={Moon} label="Moon longitude" value={`${moon?.longitudeDeg.toFixed(2)}°`} sub="analytical baseline" tint="blue"/>
   <StatCard icon={ShieldCheck} label="Invariants" value={`${passed}/${runtime.invariants.length}`} sub="scientific checks" tint="green"/>
   <StatCard icon={Database} label="Ephemeris" value="Analytical" sub="high precision provider boundary" tint="purple"/>
  </section>
  <section className="sectionHead"><div><span className="eyebrow">DISCOVER</span><h2>Pick a computational world</h2></div><button className="textButton" onClick={()=>open('Explore')}>See all <ChevronRight size={16}/></button></section>
  <section className="cardGrid">{exploreItems.slice(0,4).map(([title,desc,Icon,key],i)=><TiltCard key={key} className={`color${i}`} onClick={()=>open({page:'tool',key})}><div className="cardTop"><span className="cardNo">0{i+1}</span><span className="cardIcon"><Icon size={22}/></span></div><h3>{title}</h3><p>{desc}</p><span className="cardLink">Open module <ChevronRight size={15}/></span></TiltCard>)}</section>
  <section className="researchStrip"><div className="stackBadge"><Layers3 size={21}/></div><div><span className="eyebrow">EVIDENCE-AWARE ENGINE</span><h3>Approximate results stay approximate.</h3><p>Provider contracts, uncertainty, provenance and benchmark gates are kept visible so the interface never disguises the computational accuracy level.</p></div><span className="researchPill">{runtime.provenance.accuracy}</span></section>
 </main>
}

function ExplorePage({open,initialKey}){
 const [selected,setSelected]=useState(initialKey||'sky');
 const item=exploreItems.find(x=>x[3]===selected)||exploreItems[0]; const [title,desc,Icon]=item;
 return <main className="page"><PageTitle eyebrow="COMPUTATIONAL LABS" title="Explore AstroSun" text="Every module is a real product surface, not a decorative demo."/>
  <section className="exploreLayout"><aside className="sideRail">{exploreItems.map(([t,d,I,k])=><button className={k===selected?'railItem active':'railItem'} onClick={()=>setSelected(k)} key={k}><I size={18}/><span>{t}</span></button>)}</aside>
   <section className="toolWorkspace"><div className="toolHero"><div className="toolOrb"><Icon size={34}/></div><span className="eyebrow">ACTIVE MODULE</span><h2>{title}</h2><p>{desc}</p></div>
   {selected==='sky'&&<SkyTool/>}{selected==='physics'&&<PhysicsTool/>}{selected==='eclipse'&&<EclipseTool/>}{selected==='observer'&&<ObserverTool/>}{selected==='dynamics'&&<DynamicsTool/>}{selected==='evidence'&&<EvidenceTool/>}
   <button className="toolBack" onClick={()=>open('Home')}><ArrowLeft size={16}/> Back to dashboard</button>
   </section>
  </section>
 </main>
}
function SkyTool(){return <div className="toolGrid"><TiltCard className="wideCard cyan"><span className="cardMini">STATE VECTOR</span><strong>Solar-system geometry</strong><p>Switch between analytical baseline and an injected high-precision provider without changing consumers.</p><div className="chipRow"><span>Frame contracts</span><span>TT / TDB boundary</span><span>Angular geometry</span></div></TiltCard><StatCard icon={Telescope} label="Provider" value="Analytical" sub="external DE/SPICE required" tint="blue"/><StatCard icon={Layers3} label="Frame" value="Ecliptic" sub="provider contract ready" tint="purple"/><TiltCard className="wideCard yellow"><span className="cardMini">NEXT LAYER</span><strong>Observer-aware sky</strong><p>Rise/set, refraction, apparent disk and topocentric correction remain separate accuracy-controlled layers.</p></TiltCard></div>}
function PhysicsTool(){return <div className="toolGrid"><StatCard icon={Atom} label="Relativity" value="Ready" sub="time dilation + compactness" tint="purple"/><StatCard icon={Globe2} label="Cosmology" value="ΛCDM" sub="flat baseline model" tint="cyan"/><TiltCard className="wideCard violet"><span className="cardMini">PHYSICS NOTEBOOK</span><strong>From formula → invariant → explanation</strong><p>AstroSun keeps equations deterministic and surfaces the assumptions beside every computed quantity.</p></TiltCard></div>}
function EclipseTool(){return <div className="toolGrid"><StatCard icon={Eclipse} label="Geometry" value="Ready" sub="disk-overlap classification" tint="yellow"/><StatCard icon={Calculator} label="Contacts" value="Contract" sub="path/contact provider boundary" tint="cyan"/><TiltCard className="wideCard orange"><span className="cardMini">ECLIPSE PIPELINE</span><strong>Candidate → geometry → contacts → path</strong><p>Candidate detection is kept distinct from authoritative contact/path calculations so coarse methods never masquerade as final eclipse predictions.</p></TiltCard></div>}
function ObserverTool(){return <div className="toolGrid"><StatCard icon={MapPin} label="Observer" value="Ready" sub="geodetic context" tint="green"/><StatCard icon={Clock3} label="Refraction" value="Ready" sub="policy-controlled" tint="blue"/><TiltCard className="wideCard green"><span className="cardMini">LOCAL SKY</span><strong>Rise / set with explicit assumptions</strong><p>Observer geometry, horizon policy and refraction are separate modules, making the accuracy boundary visible.</p></TiltCard></div>}
function DynamicsTool(){return <div className="toolGrid"><StatCard icon={Activity} label="Integrator" value="RK4" sub="plus velocity-Verlet" tint="purple"/><StatCard icon={RotateCcw} label="Invariants" value="Live" sub="energy / momentum checks" tint="green"/><TiltCard className="wideCard cyan"><span className="cardMini">DYNAMICS LAB</span><strong>Kepler → N-body → covariance</strong><p>Use explicit state vectors and propagation requests. High-precision ephemerides stay behind the provider boundary.</p></TiltCard></div>}
function EvidenceTool(){return <div className="toolGrid"><StatCard icon={BookOpen} label="Evidence" value="Graph" sub="claim-linked provenance" tint="blue"/><StatCard icon={ShieldCheck} label="Accuracy" value="Visible" sub="no hidden confidence" tint="green"/><TiltCard className="wideCard yellow"><span className="cardMini">RESEARCH VAULT</span><strong>Papers become traceable evidence</strong><p>AstroSun’s research layer is designed to attach claims to sources, assumptions and uncertainty rather than producing citation-shaped decoration.</p></TiltCard></div>}

function PanchangaPage({onBack}){const [date,setDate]=useState(new Date().toISOString().slice(0,10));const [place,setPlace]=useState('Patna');const snap=computePanchanga(new Date(`${date}T12:00:00+05:30`),{sidereal:true,location:{latitudeDeg:25.5941,longitudeDeg:85.1376,timeZone:'Asia/Kolkata'},ruleSet:'generic-lunisolar-v1'});return <main className="page"><PageTitle eyebrow="PANCHANGA" title="Daily Panchanga" text="Astronomical baseline + explicit regional rule context." onBack={onBack}/><section className="formCard"><div><label>Date</label><input type="date" value={date} onChange={e=>setDate(e.target.value)}/></div><div><label>Location</label><input value={place} onChange={e=>setPlace(e.target.value)}/></div></section><section className="panchangaHero"><div><span className="eyebrow">{snap.localDate} • {place}</span><h2>{snap.tithi.paksha} Paksha — Tithi {snap.tithi.number}</h2><p>{snap.nakshatra.name} • Pada {snap.nakshatra.pada} • {snap.yogaName} • {snap.karanaName}</p></div><div className="moonDisk"><Moon size={54}/></div></section><section className="statsGrid"><StatCard icon={Sun} label="Sun" value={`${snap.sunLongitudeDeg.toFixed(2)}°`} sub="sidereal longitude" tint="yellow"/><StatCard icon={Moon} label="Moon" value={`${snap.moonLongitudeDeg.toFixed(2)}°`} sub="sidereal longitude" tint="blue"/><StatCard icon={CalendarDays} label="Tithi phase" value={`${snap.tithi.phaseAngleDeg.toFixed(2)}°`} sub="Moon − Sun" tint="purple"/><StatCard icon={ShieldCheck} label="Accuracy" value="Approx." sub="high-precision provider pending" tint="orange"/></section></main>}

function KundaliPage({onBack}){const [birth,setBirth]=useState('2008-01-01T12:00');const [name,setName]=useState('Research Subject');const [lat,setLat]=useState('25.5941');const [lon,setLon]=useState('85.1376');const d=new Date(birth);const snap=computePanchanga(d,{sidereal:true,location:{latitudeDeg:Number(lat),longitudeDeg:Number(lon),timeZone:'Asia/Kolkata'},ruleSet:'generic-lunisolar-v1'});return <main className="page"><PageTitle eyebrow="KUNDALI LAB" title="Birth geometry" text="A transparent astronomical chart substrate; full house/dasha tables remain provider-dependent." onBack={onBack}/><section className="formCard formGrid"><div><label>Name</label><input value={name} onChange={e=>setName(e.target.value)}/></div><div><label>Birth date & time</label><input type="datetime-local" value={birth} onChange={e=>setBirth(e.target.value)}/></div><div><label>Latitude</label><input value={lat} onChange={e=>setLat(e.target.value)}/></div><div><label>Longitude</label><input value={lon} onChange={e=>setLon(e.target.value)}/></div></section><section className="chartBoard"><div className="chartGlow"/><div className="chartCenter"><Orbit size={44}/><b>{name}</b><small>{d.toISOString().replace('T',' ').slice(0,16)} UTC</small></div>{['Sun','Moon','Mars','Mercury','Jupiter','Venus','Saturn','Rahu','Ketu'].map((x,i)=><span key={x} className={`chartNode node${i+1}`}>{x}</span>)}</section><section className="cardGrid"><TiltCard className="color1"><span className="cardMini">SIDEREAL BASELINE</span><h3>Sun {snap.sunLongitudeDeg.toFixed(2)}°</h3><p>Computed from AstroSun analytical ephemeris.</p></TiltCard><TiltCard className="color2"><span className="cardMini">LUNAR BASELINE</span><h3>Moon {snap.moonLongitudeDeg.toFixed(2)}°</h3><p>{snap.nakshatra.name} • Pada {snap.nakshatra.pada}</p></TiltCard><TiltCard className="color3"><span className="cardMini">PROVIDER STATUS</span><h3>Approximate</h3><p>External DE/SPICE/CALCEPH provider is required for research-grade charting.</p></TiltCard></section></main>}

function ResearchPage({onBack}){return <main className="page"><PageTitle eyebrow="RESEARCH VAULT" title="Evidence-aware astronomy" text="Papers, provenance and scientific implementation stay connected." onBack={onBack}/><section className="researchHero"><span className="eyebrow">ALPHAXIV-ALIGNED ARCHITECTURE</span><h2>From paper → implementation contract → validation gate.</h2><p>Current research keeps AstroSun’s architecture focused on ephemeris/provider boundaries, explicit time and reference-frame contracts, and validated computational fallbacks.</p></section><section className="cardGrid"><TiltCard className="color0"><span className="cardMini">TEMPUS</span><h3>Relativistic time</h3><p>Ephemeris-agnostic time transformations motivate keeping time-scale conversion explicit and provider-aware.</p></TiltCard><TiltCard className="color1"><span className="cardMini">JORBIT</span><h3>High precision</h3><p>Differentiable high-precision ephemerides reinforce the need for a modular external-kernel adapter rather than fake precision.</p></TiltCard><TiltCard className="color2"><span className="cardMini">SOLARSYSTEM</span><h3>Validated fallback</h3><p>Lightweight analytical calculations can be useful when their tested accuracy limits remain visible.</p></TiltCard><TiltCard className="color3"><span className="cardMini">ASTROPY</span><h3>Open science</h3><p>AstroSun follows a modular, research-friendly direction with explicit contracts and reproducible validation.</p></TiltCard></section></main>}

function SettingsPage({onBack}){return <main className="page"><PageTitle eyebrow="SYSTEM" title="Settings" text="Control display and computational presentation preferences." onBack={onBack}/><section className="settingsGrid"><TiltCard className="wideCard cyan"><span className="cardMini">DESIGN ENGINE</span><h3>2.5D / colour-rich interface</h3><p>Depth, layered cards, colourful modules and responsive touch targets are the default AstroSun language.</p></TiltCard><TiltCard className="wideCard yellow"><span className="cardMini">SCIENTIFIC HONESTY</span><h3>Accuracy labels stay visible</h3><p>Approximate, high-precision and provider-required states are never collapsed into one generic “accurate” label.</p></TiltCard></section></main>}

function App(){
 const [intro,setIntro]=useState(true); const [page,setPage]=useState('Home'); const [tool,setTool]=useState('sky'); const [runtime,setRuntime]=useState(()=>buildRuntimeSnapshot());
 useEffect(()=>{const t=setTimeout(()=>setIntro(false),1200); return()=>clearTimeout(t)},[]); useEffect(()=>{const id=setInterval(()=>setRuntime(buildRuntimeSnapshot()),60000);return()=>clearInterval(id)},[]); useEffect(()=>{if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(()=>{})},[]);
 const open=(target)=>{if(typeof target==='string'){setPage(target)}else if(target?.page==='tool'){setTool(target.key);setPage('Explore')}};
 if(intro)return <div className="splash"><div className="splashCore"><div className="sunCore"><Sun size={58}/></div><span className="splashOrb">ASTROSUN</span><h1>Cosmic Intelligence</h1><p>ASTRONOMY • ASTROPHYSICS • JYOTISHA</p><div className="loader"><span/></div></div></div>;
 let content=<HomePage runtime={runtime} open={open}/>;
 if(page==='Explore')content=<ExplorePage open={open} initialKey={tool}/>; else if(page==='Panchanga')content=<PanchangaPage onBack={()=>open('Home')}/>; else if(page==='Kundali')content=<KundaliPage onBack={()=>open('Home')}/>; else if(page==='Research')content=<ResearchPage onBack={()=>open('Home')}/>; else if(page==='Settings')content=<SettingsPage onBack={()=>open('Home')}/>;
 return <div className="app"><Header onHome={()=>open('Home')}/>{content}<nav className="bottomNav">{navItems.map(([n,I])=><button className={page===n?'sel':''} onClick={()=>open(n)} key={n}><I size={19}/><span>{n}</span></button>)}</nav></div>
}
createRoot(document.getElementById('root')).render(<App/>);
