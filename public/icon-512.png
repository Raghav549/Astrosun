*{box-sizing:border-box}html,body,#root{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#eef5ff;color:#17233b}body{overflow-x:hidden}.app{min-height:100vh;background:radial-gradient(circle at 8% 0%,#ffd56a66,transparent 22%),radial-gradient(circle at 92% 18%,#78e7ff55,transparent 24%),linear-gradient(155deg,#f7fbff 0%,#edf3ff 48%,#fff8eb 100%);padding-bottom:92px}.topbar{height:76px;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:30;background:#ffffffd9;backdrop-filter:blur(18px);border-bottom:1px solid #d7e2f2;box-shadow:0 8px 28px #4a6b9630}.brand{border:0;background:transparent;display:flex;align-items:center;gap:10px;text-align:left;color:#17233b}.brandMark{width:46px;height:46px;border-radius:16px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#7559ff,#0ea5d9 60%,#12c991);box-shadow:9px 10px 0 #cabdfb,0 18px 30px #687ab744;transform:perspective(700px) rotateX(9deg) rotateY(-8deg)}.brand b{display:block;letter-spacing:.18em;font-size:15px}.brand small{display:block;font-size:8px;letter-spacing:.13em;color:#72809a;margin-top:3px}.topActions{display:flex;gap:8px}.iconButton,.backButton{width:42px;height:42px;border-radius:14px;border:1px solid #d5e0ef;background:linear-gradient(145deg,#fff,#ecf3fb);display:grid;place-items:center;color:#536782;box-shadow:4px 5px 0 #ccd8e8,0 10px 18px #49688922}.page{width:min(1160px,100%);margin:auto;padding:18px 16px 28px}.pageTitle{display:flex;gap:12px;align-items:flex-start;margin:6px 0 22px}.pageTitle h1{font-size:34px;line-height:1;margin:6px 0 8px;letter-spacing:-.035em}.pageTitle p{margin:0;color:#66758e;line-height:1.55;font-size:13px}.eyebrow{font-size:9px;font-weight:900;letter-spacing:.16em;color:#65789a}.hero3d{position:relative;min-height:540px;padding:38px 24px 28px;border-radius:34px;overflow:hidden;background:linear-gradient(135deg,#4e38b6 0%,#148fd1 43%,#15c8a8 72%,#ffd45e 110%);box-shadow:18px 22px 0 #c7bcfb,0 34px 70px #4c6aa244;transform:perspective(1200px) rotateX(1.5deg)}.hero3d:before{content:"";position:absolute;inset:12px;border-radius:26px;border:1px solid #ffffff42;box-shadow:inset 0 0 0 1px #ffffff12;pointer-events:none}.heroCopy{position:relative;z-index:5;max-width:640px;color:#fff}.heroCopy .eyebrow{color:#f1fbff}.heroCopy h1{font-size:48px;line-height:.99;margin:12px 0 14px;letter-spacing:-.05em}.heroCopy h1 em{font-style:normal;color:#ffe08b}.heroCopy p{max-width:590px;color:#eefcff;line-height:1.65;font-size:15px}.heroButtons{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.btn{border:1px solid #ffffff55;background:#ffffff1b;color:#fff;border-radius:16px;padding:12px 15px;display:inline-flex;gap:8px;align-items:center;font-weight:850;box-shadow:0 9px 22px #172f5d28;backdrop-filter:blur(10px)}.btnAccent{background:linear-gradient(135deg,#ff8d41,#ffca49);border-color:#ffe6a6;box-shadow:0 12px 25px #ff9a3d55}.orbitalRing{position:absolute;border:1px solid #ffffff38;border-radius:50%;pointer-events:none}.ring1{width:620px;height:260px;right:-130px;top:60px;transform:rotate(-18deg)}.ring2{width:500px;height:190px;right:-60px;top:170px;transform:rotate(22deg);border-color:#ffec9d72}.heroSun,.heroMoon{position:absolute;display:grid;place-items:center;border-radius:50%;z-index:2}.heroSun{width:170px;height:170px;right:100px;top:92px;color:#fff5bf;background:radial-gradient(circle at 32% 28%,#fffbd2,#ffc74f 43%,#ef793d 76%);box-shadow:16px 18px 0 #b84d73,0 30px 65px #1a244f55;animation:floaty 5.5s ease-in-out infinite}.heroMoon{width:86px;height:86px;right:280px;top:286px;color:#f4f7ff;background:radial-gradient(circle at 34% 28%,#ffffff,#aab7d4 67%,#7382a0);box-shadow:9px 10px 0 #596a90,0 20px 34px #1d264d55;animation:floaty2 6s ease-in-out infinite}.heroFloat{position:absolute;right:26px;bottom:24px;z-index:5;padding:14px 16px;border-radius:20px;background:#fffdf3e8;color:#304059;box-shadow:10px 11px 0 #dfcc7a,0 24px 35px #2b446b40;min-width:190px}.heroFloat span{display:block;font-size:8px;letter-spacing:.16em;font-weight:900;color:#c07a28}.heroFloat b{display:block;margin-top:3px;font-size:17px}.heroFloat small{display:block;margin-top:3px;color:#687992}.statsGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:20px 0}.statCard{min-height:126px;padding:15px;border:1px solid #d6e2f1;border-radius:23px;background:linear-gradient(145deg,#fff,#eef4fb);box-shadow:8px 9px 0 #ccd8e8,0 18px 32px #405b7720;display:flex;flex-direction:column;align-items:flex-start}.statIcon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:#fff;box-shadow:3px 4px 0 #d4dce8;margin-bottom:9px}.statCard>span{font-size:9px;letter-spacing:.1em;color:#71819a;font-weight:850;text-transform:uppercase}.statCard strong{font-size:20px;margin-top:5px;color:#263852}.statCard small{font-size:10px;color:#8190a7;margin-top:4px}.statCard.yellow .statIcon{color:#de8b00;background:#fff6ce}.statCard.blue .statIcon{color:#1575d1;background:#dff4ff}.statCard.green .statIcon{color:#0a9b72;background:#dcfff0}.statCard.purple .statIcon{color:#7356d9;background:#ede7ff}.statCard.orange .statIcon{color:#e76b2f;background:#ffe4d2}.sectionHead{display:flex;align-items:end;justify-content:space-between;margin:34px 0 14px}.sectionHead h2{margin:6px 0 0;font-size:27px;letter-spacing:-.03em}.textButton,.cardLink,.toolBack{border:0;background:transparent;color:#5e52d9;font-weight:850;display:flex;align-items:center;gap:4px}.cardGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.tiltCard{position:relative;text-align:left;border:1px solid #d4e0ef;border-radius:25px;padding:17px;min-height:175px;background:linear-gradient(145deg,#fff,#eef3fb);box-shadow:9px 11px 0 #cbd7e8,0 24px 38px #3d5a7d1c;transform:perspective(1000px) rotateX(2deg) rotateY(-2deg);transition:.18s ease;color:#1b2a43}.tiltCard:hover{transform:perspective(1000px) translateY(-5px) rotateX(4deg) rotateY(-3deg);box-shadow:12px 15px 0 #c1cde0,0 30px 46px #3d5a7d2a}.tiltCard.color0{background:linear-gradient(145deg,#fff,#e9e2ff)}.tiltCard.color1{background:linear-gradient(145deg,#fff,#e0f7ff)}.tiltCard.color2{background:linear-gradient(145deg,#fff,#fff1c9)}.tiltCard.color3{background:linear-gradient(145deg,#fff,#ddfff2)}.cardTop{display:flex;justify-content:space-between;align-items:center}.cardNo,.cardMini{font-size:8px;font-weight:900;letter-spacing:.15em;color:#7788a2}.cardIcon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:#ffffffcc;box-shadow:4px 5px 0 #d1dbea}.tiltCard h3{font-size:19px;margin:22px 0 7px}.tiltCard p{font-size:11px;line-height:1.5;color:#697b96;margin:0}.cardLink{position:absolute;left:17px;bottom:15px;font-size:10px}.researchStrip{margin-top:22px;display:flex;gap:14px;align-items:center;padding:18px;border-radius:25px;background:linear-gradient(135deg,#182c66,#4f39ad 46%,#0ea8ad);color:#fff;box-shadow:10px 12px 0 #b8bee7,0 25px 45px #374c7b30}.researchStrip h3{margin:5px 0 3px;font-size:20px}.researchStrip p{margin:0;color:#dce9ff;font-size:11px;line-height:1.5}.stackBadge{width:52px;height:52px;flex:none;border-radius:17px;background:#ffffff19;border:1px solid #ffffff35;display:grid;place-items:center;box-shadow:4px 5px 0 #202d5d}.researchPill{margin-left:auto;align-self:flex-start;background:#ffffff1b;border:1px solid #ffffff35;border-radius:999px;padding:7px 10px;font-size:9px;letter-spacing:.12em}.exploreLayout{display:grid;grid-template-columns:240px 1fr;gap:18px}.sideRail{display:flex;flex-direction:column;gap:9px}.railItem{display:flex;align-items:center;gap:10px;border:1px solid #d5e0ef;border-radius:17px;padding:12px;background:linear-gradient(145deg,#fff,#edf3fa);color:#64748b;box-shadow:5px 6px 0 #ccd7e6}.railItem.active{background:linear-gradient(135deg,#5643ce,#168ec8);color:#fff;border-color:#7f7be1;box-shadow:6px 7px 0 #aaa8df}.toolWorkspace{min-width:0}.toolHero{padding:23px;border-radius:28px;background:linear-gradient(135deg,#26397f,#195fa6 48%,#13a69b);color:#fff;box-shadow:9px 11px 0 #becbf0,0 26px 44px #3e609029;margin-bottom:17px}.toolOrb{width:58px;height:58px;border-radius:19px;display:grid;place-items:center;background:#ffffff1f;border:1px solid #ffffff36;box-shadow:5px 6px 0 #18386a;margin-bottom:16px}.toolHero .eyebrow{color:#d7ecff}.toolHero h2{font-size:32px;margin:6px 0}.toolHero p{margin:0;max-width:660px;color:#dbeeff;line-height:1.55;font-size:13px}.toolGrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.toolGrid .wideCard{grid-column:1/-1}.wideCard{min-height:160px}.wideCard strong{display:block;font-size:24px;margin:8px 0}.wideCard p{max-width:720px}.cyan{background:linear-gradient(145deg,#f7ffff,#dff9ff)}.yellow{background:linear-gradient(145deg,#fffef5,#fff0bd)}.violet{background:linear-gradient(145deg,#fff,#ebe5ff)}.orange{background:linear-gradient(145deg,#fff,#ffe2cd)}.green{background:linear-gradient(145deg,#f7fffc,#d7faeb)}.chipRow{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.chipRow span{border-radius:999px;padding:6px 9px;background:#fff;border:1px solid #d6e5f0;font-size:9px;color:#5f7290}.toolBack{margin:18px 0 0}.formCard{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px;border:1px solid #d4dfed;border-radius:25px;background:linear-gradient(145deg,#fff,#eff4fa);box-shadow:8px 9px 0 #cbd7e6;margin-bottom:17px}.formGrid{grid-template-columns:1fr 1fr}.formCard label{display:block;font-size:9px;font-weight:900;letter-spacing:.1em;color:#71819b;margin:0 0 7px;text-transform:uppercase}.formCard input{width:100%;border:1px solid #cfdae8;border-radius:13px;padding:11px 12px;font:inherit;color:#223149;background:#fff;outline:none;box-shadow:inset 0 2px 5px #39536b0b}.panchangaHero,.researchHero{position:relative;padding:25px;border-radius:29px;background:linear-gradient(135deg,#6d42cb,#0d93bc 55%,#14ba9b);color:#fff;box-shadow:10px 12px 0 #bfc6ed,0 28px 45px #3d587526;margin-bottom:18px}.panchangaHero h2,.researchHero h2{font-size:30px;line-height:1.05;max-width:640px;margin:7px 0}.panchangaHero p,.researchHero p{margin:0;color:#deefff;line-height:1.55;font-size:12px}.moonDisk{position:absolute;right:28px;top:26px;width:105px;height:105px;border-radius:50%;display:grid;place-items:center;color:#fff;background:radial-gradient(circle at 35% 30%,#fff,#aab8d8 58%,#667497);box-shadow:11px 13px 0 #56617b,0 24px 36px #10254b45}.chartBoard{height:420px;border-radius:34px;position:relative;overflow:hidden;margin:18px 0;background:radial-gradient(circle at 50% 48%,#fff5ba 0 8%,transparent 9%),radial-gradient(circle at 50% 48%,#3d52c7 0 27%,#23235e 28% 55%,#101637 56%);box-shadow:15px 16px 0 #bfc7e7,0 30px 50px #2e446c35}.chartBoard:before,.chartBoard:after{content:"";position:absolute;inset:12%;border:1px solid #ffffff30;border-radius:50%;transform:rotate(17deg)}.chartBoard:after{inset:23%;transform:rotate(-29deg);border-style:dashed}.chartGlow{position:absolute;inset:0;background:radial-gradient(circle at 50% 48%,#ffe47a66,transparent 24%),radial-gradient(circle at 30% 30%,#4fd6ff25,transparent 30%)}.chartCenter{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:170px;height:170px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;color:#fff;background:#ffffff10;border:1px solid #ffffff32;box-shadow:10px 12px 0 #151b45,0 22px 42px #00000045;backdrop-filter:blur(9px);z-index:3}.chartCenter b{font-size:12px}.chartCenter small{font-size:8px;color:#becbf2}.chartNode{position:absolute;padding:7px 10px;border-radius:999px;background:#ffffffef;color:#293652;font-size:9px;font-weight:900;box-shadow:4px 5px 0 #afb9d0;z-index:4}.node1{top:13%;left:48%}.node2{top:25%;right:10%}.node3{top:53%;right:6%}.node4{bottom:16%;right:20%}.node5{bottom:9%;left:49%}.node6{bottom:16%;left:18%}.node7{top:52%;left:6%}.node8{top:24%;left:13%}.node9{top:9%;left:20%}.settingsGrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.splash{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 50% 32%,#ffe085 0,transparent 17%),linear-gradient(145deg,#151e52,#3d2a9f 47%,#0b9eb0);color:#fff}.splashCore{text-align:center}.sunCore{width:110px;height:110px;margin:auto;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#fffbdc,#ffc84b 45%,#ef6b4e 76%);box-shadow:11px 12px 0 #7a3578,0 30px 68px #ffd96e77;animation:floaty 4s ease-in-out infinite}.splashOrb{display:block;font-size:25px;letter-spacing:.24em;font-weight:900;margin-top:23px}.splashCore h1{font-size:16px;margin:6px 0;color:#dfeaff}.splashCore p{font-size:9px;letter-spacing:.12em;color:#becaf0}.loader{width:140px;height:4px;background:#ffffff29;margin:24px auto 0;border-radius:10px;overflow:hidden}.loader span{display:block;width:38%;height:100%;background:#ffb741;animation:load 1.2s ease forwards}.bottomNav{position:fixed;left:10px;right:10px;bottom:10px;height:70px;padding:6px;border-radius:24px;background:#ffffffea;backdrop-filter:blur(18px);border:1px solid #d2dfec;box-shadow:10px 14px 34px #39587c35;display:flex;justify-content:space-around;align-items:center;z-index:50}.bottomNav button{min-width:58px;border:0;background:transparent;color:#8391a5;display:grid;place-items:center;gap:4px;font-size:9px}.bottomNav button.sel{color:#634bd4;font-weight:900}.bottomNav button.sel svg{stroke:#13a28f;filter:drop-shadow(1px 2px 0 #a5e8dc)}@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}@keyframes floaty2{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(9px) rotate(5deg)}}@keyframes load{to{transform:translateX(280%)}}@media(max-width:900px){.statsGrid{grid-template-columns:1fr 1fr}.cardGrid{grid-template-columns:1fr 1fr}.exploreLayout{grid-template-columns:1fr}.sideRail{display:grid;grid-template-columns:repeat(3,1fr)}.railItem{justify-content:center}.heroSun{right:44px;top:110px}.heroMoon{right:230px}.heroCopy{max-width:72%}}@media(max-width:620px){.page{padding:14px 12px 22px}.hero3d{min-height:590px;border-radius:28px;padding:27px 19px}.heroCopy{max-width:none}.heroCopy h1{font-size:36px}.heroCopy p{font-size:13px;max-width:340px}.heroSun{width:132px;height:132px;right:22px;top:270px}.heroMoon{width:70px;height:70px;right:137px;top:370px}.ring1{width:390px;height:160px;right:-170px;top:290px}.ring2{width:350px;height:130px;right:-120px;top:370px}.heroFloat{left:16px;right:16px;bottom:18px}.statsGrid{grid-template-columns:1fr 1fr;gap:10px}.statCard{min-height:112px;padding:12px}.cardGrid,.toolGrid,.settingsGrid,.formCard,.formGrid{grid-template-columns:1fr}.sideRail{grid-template-columns:1fr 1fr}.pageTitle h1{font-size:29px}.panchangaHero h2,.researchHero h2{font-size:25px}.moonDisk{width:78px;height:78px;right:17px}.chartBoard{height:390px}.chartCenter{width:135px;height:135px}.chartNode{font-size:8px}.bottomNav{height:66px}.bottomNav button{min-width:48px}.brand small{display:none}.topbar{padding:9px 12px}.brandMark{width:42px;height:42px}}
